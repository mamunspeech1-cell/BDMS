    🤖

</button>


<!-- ================= AI CHAT BOX ================= -->

<div class="chat-box" id="chatBox">

    <div class="chat-header">

        <h3>
            🤖 Shokher Bazar Assistant
        </h3>

        <button class="chat-close"
                onclick="toggleChat()">
            ×
        </button>

    </div>


    <div class="chat-body" id="chatBody">

        <div class="bot-message">

            👋 আসসালামু আলাইকুম!<br><br>

            আমি <strong>Shokher Bazar Assistant</strong>।
            আপনাকে পণ্য খুঁজে পেতে সাহায্য করতে পারি।

            <br><br>

            যেমন লিখতে পারেন:
            <br>
            • ঘড়ি চাই<br>
            • ১০০০ টাকার মধ্যে পণ্য চাই<br>
            • Electronics দেখান<br>
            • কিভাবে অর্ডার করবো?

        </div>

    </div>


    <div class="chat-input">

        <input
            type="text"
            id="chatInput"
            placeholder="আপনার প্রশ্ন লিখুন..."
            onkeypress="handleChatKey(event)"
        >

        <button onclick="sendMessage()">
            ➤
        </button>

    </div>

</div>


<!-- ================= JAVASCRIPT ================= -->

<script>

/* ================= MESSAGE ================= */

function showMessage(message){

    alert(message);

}


/* ================= WISHLIST ================= */

function addWishlist(button){

    if(button.innerHTML === "♡"){

        button.innerHTML = "❤️";

        alert("পণ্যটি Wishlist-এ যোগ হয়েছে ❤️");

    }else{

        button.innerHTML = "♡";

    }

}


/* ================= ORDER ================= */

function orderProduct(productName){

    let message =
    "আসসালামু আলাইকুম, আমি Shokher Bazar থেকে \"" +
    productName +
    "\" অর্ডার করতে চাই।";

    let url =
    "https://wa.me/8801869349388?text=" +
    encodeURIComponent(message);

    window.open(url,"_blank");

}


/* ================= SEARCH ================= */

function searchProducts(){

    let search =
    document.getElementById("searchInput")
    .value
    .toLowerCase()
    .trim();

    let products =
    document.querySelectorAll(".product");

    products.forEach(function(product){

        let name =
        product
        .querySelector("h3")
        .innerText
        .toLowerCase();

        if(search === "" || name.includes(search)){

            product.style.display = "";

        }else{

            product.style.display = "none";

        }

    });

}


/* ================= CATEGORY FILTER ================= */

function filterCategory(category){

    let products =
    document.querySelectorAll(".product");

    products.forEach(function(product){

        if(product.dataset.category === category){

            product.style.display = "";

        }else{

            product.style.display = "none";

        }

    });

    document
    .getElementById("products")
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* ================= AI CHAT ================= */

function toggleChat(){

    let chat =
    document.getElementById("chatBox");

    if(chat.style.display === "block"){

        chat.style.display = "none";

    }else{

        chat.style.display = "block";

        document
        .getElementById("chatInput")
        .focus();

    }

}


/* ================= CHAT ENTER ================= */

function handleChatKey(event){

    if(event.key === "Enter"){

        sendMessage();

    }

}


/* ================= CHAT ================= */

function sendMessage(){

    let input =
    document.getElementById("chatInput");

    let message =
    input.value.trim();

    if(message === ""){

        return;

    }


    let chatBody =
    document.getElementById("chatBody");


    /* USER MESSAGE */

    let userMessage =
    document.createElement("div");

    userMessage.className =
    "user-message";

    userMessage.innerText =
    message;

    chatBody.appendChild(userMessage);


    input.value = "";


    /* BOT RESPONSE */

    setTimeout(function(){

        let response =
        getBotResponse(message);


        let botMessage =
        document.createElement("div");

        botMessage.className =
        "bot-message";

        botMessage.innerHTML =
        response;

        chatBody.appendChild(botMessage);


        chatBody.scrollTop =
        chatBody.scrollHeight;

    },500);

}


/* ================= BOT LOGIC ================= */

function getBotResponse(message){

    let text =
    message.toLowerCase();


    if(
        text.includes("ঘড়ি") ||
        text.includes("watch")
    ){

        return `
        ⌚ আমাদের Premium Men's Watch
        বর্তমানে ৳1,250।<br><br>
        অর্ডার করতে "Order Now" অথবা WhatsApp ব্যবহার করুন।
        `;

    }


    if(
        text.includes("মানিব্যাগ") ||
        text.includes("wallet")
    ){

        return `
        👛 Premium Leather Wallet
        এর দাম ৳550।<br><br>
        চাইলে এখনই অর্ডার করতে পারেন।
        `;

    }


    if(
        text.includes("চশমা") ||
        text.includes("sunglass")
    ){

        return `
        🕶️ Premium Sunglasses
        এর দাম ৳690।
        `;

    }


    if(
        text.includes("electronics") ||
        text.includes("ইলেকট্রনিক")
    ){

        return `
        🎧 Electronics category-তে
        Wireless Headphone এবং Mobile Accessories
        রয়েছে।
        `;

    }


    if(
        text.includes("অর্ডার") ||
        text.includes("order")
    ){

        return `
        🛍️ অর্ডার করতে পছন্দের পণ্যের
        "Order Now" button চাপুন।
        <br><br>
        অথবা WhatsApp-এ আমাদের সাথে যোগাযোগ করুন।
        `;

    }


    if(
        text.includes("দাম") ||
        text.includes("price")
    ){

        return `
        💰 কোন পণ্যের দাম জানতে চান?
        যেমন: "ঘড়ির দাম কত?"
        `;

    }


    if(
        text.includes("যোগাযোগ") ||
        text.includes("contact")
    ){

        return `
        📱 01869-349388<br>
        📱 01742-224930<br><br>
        📧 shikherbazar@gmail.com
        `;

    }


    return `
    😊 আপনার প্রশ্নটি বুঝতে পারিনি।<br><br>

    আপনি লিখতে পারেন:<br>

    • ঘড়ি চাই<br>
    • মানিব্যাগের দাম কত?<br>
    • Electronics দেখান<br>
    • কিভাবে অর্ডার করবো?<br>
    • যোগাযোগ
    `;

}

</script>

</body>
</html>
