<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Md. Abdullah Al Mamun | Project Engineer</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, #071e3d, #0b5ed7);
            color: white;
            padding: 80px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        header h2 {
            font-size: 22px;
            font-weight: normal;
            color: #dbeafe;
            margin-bottom: 15px;
        }

        header p {
            font-size: 16px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            padding: 12px 22px;
            background: white;
            color: #0b5ed7;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            margin: 5px;
        }

        nav {
            background: #06172f;
            padding: 15px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
            font-size: 14px;
        }

        .container {
            max-width: 1050px;
            margin: auto;
            padding: 40px 20px;
        }

        section {
            margin-bottom: 45px;
        }

        .section-title {
            text-align: center;
            color: #0b5ed7;
            font-size: 30px;
            margin-bottom: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            margin-bottom: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .card h3 {
            color: #071e3d;
            margin-bottom: 8px;
        }

        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
        }

        .skill {
            background: #eaf2ff;
            color: #0b5ed7;
            padding: 15px;
            text-align: center;
            border-radius: 10px;
            font-weight: bold;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .project {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .project h3 {
            color: #0b5ed7;
            margin-bottom: 10px;
        }

        .contact {
            text-align: center;
        }

        footer {
            background: #06172f;
            color: white;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 29px;
            }

            header h2 {
                font-size: 18px;
            }

            nav {
                overflow-x: auto;
                white-space: nowrap;
            }

            .section-title {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

<header id="home">
    <h1>Md. Abdullah Al Mamun</h1>
    <h2>Project Engineer (Electrical)</h2>

    <p>
        Electrical Engineering | Project Work | Maintenance | Technology
    </p>

    <a href="#about" class="btn">View Portfolio</a>
    <a href="#contact" class="btn">Contact Me</a>
</header>


<nav>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#education">Education</a>
    <a href="#experience">Experience</a>
    <a href="#skills">Skills</a>
    <a href="#training">Training</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
</nav>


